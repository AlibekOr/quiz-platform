# PostgreSQL ulanish satri (Neon'da: pooled, host'ida "-pooler" bor)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/quiz_platform?schema=public"

# Faqat migratsiyalar uchun (ixtiyoriy). Neon'da: pooler'siz ulanish satri.
# Berilmasa, migratsiya DATABASE_URL orqali bajariladi
DIRECT_URL=""

# JWT sessiya kaliti (kamida 32 belgi): openssl rand -base64 32
JWT_SECRET=""

# Seed: o'qituvchi akkaunti
SEED_TEACHER_USERNAME="teacher"
SEED_TEACHER_PASSWORD=""
SEED_TEACHER_FULLNAME="O'qituvchi"

# Seed: namunaviy o'quvchilar paroli (faqat dev; db:seed:prod uni ishlatmaydi)
SEED_STUDENT_PASSWORD=""

# Vitest: reyting SQL testlari uchun alohida baza (har testda tozalanadi!)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/quiz_platform_test?schema=public"
