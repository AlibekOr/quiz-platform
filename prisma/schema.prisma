generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Ulanish satri prisma.config.ts dan olinadi (Prisma 7)
datasource db {
  provider = "postgresql"
}

enum Role {
  TEACHER
  MANAGER
  STUDENT
}

enum DeletionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuestionType {
  SINGLE
  MULTIPLE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum ParentRelation {
  FATHER
  MOTHER
  OTHER
}

enum AttemptStatus {
  IN_PROGRESS
  FINISHED
  EXPIRED
}

model User {
  id                 String            @id @default(cuid())
  username           String            @unique
  fullName           String
  passwordHash       String
  role               Role              @default(STUDENT)
  isActive           Boolean           @default(true)
  // Parol tiklanganda oshiriladi: eski sessiyalar (JWT) yaroqsiz bo'ladi
  sessionVersion     Int               @default(0)
  // Arxivlangan (yumshoq o'chirilgan) o'quvchi: kira olmaydi, ro'yxat va reytinglarda ko'rinmaydi
  archivedAt         DateTime?
  groupId            String?
  group              Group?            @relation(fields: [groupId], references: [id])
  attempts           Attempt[]
  profile            StudentProfile?
  attendances        Attendance[]
  memberships        GroupMembership[]
  assignmentGrades   AssignmentGrade[]
  adjustments        PointAdjustment[]
  oralScores         OralScore[]
  createdTests       Test[]            @relation("TestAuthor")
  // Menejerning regioni (faqat MANAGER uchun); doirasi: region guruhlari + ManagerGroup
  regionId           String?
  region             Region?           @relation(fields: [regionId], references: [id], onDelete: SetNull)
  managedGroups      ManagerGroup[]
  // O'quvchini kim qo'shgan (menejer guruhsiz o'quvchini faqat o'zi qo'shgan bo'lsa ko'radi)
  createdById        String?
  createdBy          User?             @relation("CreatedStudents", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers       User[]            @relation("CreatedStudents")
  deletionRequests   DeletionRequest[] @relation("DeletionStudent")
  requestedDeletions DeletionRequest[] @relation("DeletionRequester")
  decidedDeletions   DeletionRequest[] @relation("DeletionDecider")
  createdAt          DateTime          @default(now())
}

model Group {
  id          String            @id @default(cuid())
  name        String            @unique
  students    User[]
  tests       Test[]
  schedules   GroupSchedule[]
  lessons     Lesson[]
  memberships GroupMembership[]
  semesters   Semester[]
  regionId    String?
  region      Region?           @relation(fields: [regionId], references: [id], onDelete: SetNull)
  managers    ManagerGroup[]
  createdAt   DateTime          @default(now())
}

model Test {
  id               String     @id @default(cuid())
  title            String
  description      String?
  durationMin      Int
  isActive         Boolean    @default(false)
  allowRetake      Boolean    @default(true)
  showAnswers      Boolean    @default(false)
  shuffleQuestions Boolean    @default(false)
  createdById      String
  createdBy        User       @relation("TestAuthor", fields: [createdById], references: [id])
  groups           Group[]
  questions        Question[]
  attempts         Attempt[]
  createdAt        DateTime   @default(now())
}

model Question {
  id      String       @id @default(cuid())
  testId  String
  test    Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  text    String
  type    QuestionType @default(SINGLE)
  points  Int          @default(1)
  order   Int
  options Option[]
  answers Answer[]
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int
}

model Attempt {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  testId        String
  test          Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  status        AttemptStatus @default(IN_PROGRESS)
  isFirst       Boolean
  startedAt     DateTime      @default(now())
  deadlineAt    DateTime
  finishedAt    DateTime?
  durationSec   Int?
  score         Int?
  maxScore      Int?
  // Savollar tartibi (question id'lar) — boshlanganda bir marta belgilanadi, yangilansa o'zgarmaydi
  questionOrder String[]      @default([])
  answers       Answer[]

  @@index([testId, isFirst, status])
  @@index([userId, testId])
}

model Answer {
  id                String   @id @default(cuid())
  attemptId         String
  attempt           Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionIds String[]
  isCorrect         Boolean?
  updatedAt         DateTime @updatedAt

  @@unique([attemptId, questionId])
}

// Login cheklovi: username bo'yicha xato urinishlar (15 daqiqalik oyna)
model LoginFailure {
  id        String   @id @default(cuid())
  username  String
  createdAt DateTime @default(now())

  @@index([username, createdAt])
}

// O'quvchining shaxsiy va aloqa ma'lumotlari (faqat o'qituvchi ko'radi — CLAUDE.md, 10-qoida)
model StudentProfile {
  id             String          @id @default(cuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone          String? // +998901234567
  telegram       String? // @username yoki +998...
  parentName     String?
  parentRelation ParentRelation?
  parentPhone    String?
  note           String?
  updatedAt      DateTime        @updatedAt
}

// Guruhning haftalik dars jadvali: har bir dars kuni uchun bitta qator
model GroupSchedule {
  id        String @id @default(cuid())
  groupId   String
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  weekday   Int // 1 = Dushanba ... 7 = Yakshanba
  startTime String // "14:00"
  endTime   String // "16:00"

  @@unique([groupId, weekday])
}

// Bitta o'tilgan dars (ma'lum sana, Asia/Tashkent)
model Lesson {
  id          String       @id @default(cuid())
  groupId     String
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date        DateTime     @db.Date
  topic       String?
  attendances Attendance[]
  oralScores  OralScore[]
  createdAt   DateTime     @default(now())

  @@unique([groupId, date])
}

model Attendance {
  id        String           @id @default(cuid())
  lessonId  String
  lesson    Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus
  note      String?
  updatedAt DateTime         @updatedAt

  @@unique([lessonId, studentId])
}

// O'quvchining guruhlar tarixi. leftAt = null — hozirgi guruh (User.groupId bilan doim mos,
// bitta tranzaksiyada yangilanadi — lib/memberships.ts). Sanalar Toshkent bo'yicha kunga solishtiriladi:
// a'zolik [joinedAt kuni, leftAt kuni) oralig'idagi darslarni qamraydi
model GroupMembership {
  id        String    @id @default(cuid())
  studentId String
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  joinedAt  DateTime
  leftAt    DateTime?
  note      String?
  createdAt DateTime  @default(now())

  @@index([studentId, joinedAt])
  @@index([groupId, joinedAt])
}

// Semestr bali (PLAN.md, 17-bosqich): har guruhga alohida semestrlar.
// Jadval nomi eskicha ("Period") — ma'lumot ko'chirilmaydi
model Semester {
  id           String            @id @default(cuid())
  groupId      String
  group        Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name         String
  startDate    DateTime          @db.Date
  endDate      DateTime          @db.Date
  // O'qituvchi semestrni muddatidan oldin yopishi mumkin (EXTRA shundan keyin qo'yiladi)
  closed       Boolean           @default(false)
  maxTotal     Int               @default(60)
  // O'tish: jami >= maxTotal * passPercent / 100 (60 dan 36)
  passPercent  Int               @default(60)
  // EXTRA'siz jami shundan kam bo'lsa — yiqildi, qo'shimcha imkoniyat yo'q
  failBelow    Int               @default(10)
  homeworkCap  Int               @default(30)
  practicalCap Int               @default(20)
  oralCap      Int               @default(10)
  extraCap     Int               @default(40)
  assignments  Assignment[]
  adjustments  PointAdjustment[]
  createdAt    DateTime          @default(now())

  @@unique([groupId, name])
  @@index([groupId, startDate])
  @@map("Period")
}

enum AssignmentCategory {
  HOMEWORK
  PRACTICAL
  EXTRA
  BONUS
}

// Topshiriq (uyga vazifa, amaliy, qo'shimcha, bonus). O'quvchi saytda hech narsa topshirmaydi:
// ishni darsda ko'rsatadi, ballni o'qituvchi qo'yadi. HOMEWORK doim maxPoints = 1.
// Jadval nomi eskicha ("Homework")
model Assignment {
  id          String             @id @default(cuid())
  semesterId  String             @map("periodId")
  semester    Semester           @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  category    AssignmentCategory @default(HOMEWORK)
  title       String
  description String?
  dueDate     DateTime           @db.Date
  maxPoints   Int
  createdById String
  grades      AssignmentGrade[]
  createdAt   DateTime           @default(now())

  @@index([semesterId, dueDate])
  @@map("Homework")
}

// Topshiriq bali: HOMEWORK — 0 / 0.5 / 1, qolganlari 0..maxPoints (0.5 qadam)
model AssignmentGrade {
  id           String     @id @default(cuid())
  assignmentId String     @map("homeworkId")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  points       Float
  note         String?
  gradedAt     DateTime   @updatedAt

  @@unique([assignmentId, studentId])
  @@map("HomeworkGrade")
}

// Og'zaki savol-javob: dars kuni 0 / 0.5 / 1. Semestri dars sanasidan aniqlanadi
model OralScore {
  id          String   @id @default(cuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  points      Float
  note        String?
  createdById String
  updatedAt   DateTime @updatedAt

  @@unique([lessonId, studentId])
  @@index([studentId])
}

// Semestr baliga qo'lda tuzatish (manfiy ham bo'lishi mumkin), masalan boshqa guruhdan
// o'tkazilgan o'quvchining ballari
model PointAdjustment {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semesterId  String   @map("periodId")
  semester    Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  points      Float
  reason      String
  createdById String
  createdAt   DateTime @default(now())

  @@index([studentId, semesterId])
}

model Region {
  id        String   @id @default(cuid())
  name      String   @unique
  groups    Group[]
  managers  User[]
  createdAt DateTime @default(now())
}

// O'qituvchi menejerga qo'lda biriktirgan qo'shimcha guruhlar (regiondan tashqari)
model ManagerGroup {
  id        String   @id @default(cuid())
  managerId String
  manager   User     @relation(fields: [managerId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([managerId, groupId])
}

// Menejerning o'quvchini o'chirish so'rovi. Tasdiqlansa o'quvchi arxivlanadi.
// Bitta o'quvchiga bir vaqtda faqat bitta PENDING: qisman unique indeks (faqat SQL migratsiyada)
model DeletionRequest {
  id            String         @id @default(cuid())
  studentId     String
  student       User           @relation("DeletionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User           @relation("DeletionRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reason        String
  status        DeletionStatus @default(PENDING)
  decidedById   String?
  decidedBy     User?          @relation("DeletionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime       @default(now())

  @@index([status, createdAt])
  @@index([requestedById, createdAt])
}
