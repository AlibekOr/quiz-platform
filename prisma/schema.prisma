generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Ulanish satri prisma.config.ts dan olinadi (Prisma 7)
datasource db {
  provider = "postgresql"
}

enum Role {
  // Markaz rahbariyati: regionlar, o'qituvchilar, butun markaz (ROLES.md)
  ADMIN
  TEACHER
  MANAGER
  STUDENT
}

enum DeletionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuestionType {
  SINGLE
  MULTIPLE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ParentRelation {
  FATHER
  MOTHER
  OTHER
}

enum AttemptStatus {
  IN_PROGRESS
  FINISHED
  EXPIRED
}

model User {
  id                 String            @id @default(cuid())
  username           String            @unique
  fullName           String
  passwordHash       String
  role               Role              @default(STUDENT)
  isActive           Boolean           @default(true)
  // Parol tiklanganda oshiriladi: eski sessiyalar (JWT) yaroqsiz bo'ladi
  sessionVersion     Int               @default(0)
  // Arxivlangan (yumshoq o'chirilgan) o'quvchi: kira olmaydi, ro'yxat va reytinglarda ko'rinmaydi
  archivedAt         DateTime?
  groupId            String?
  group              Group?            @relation(fields: [groupId], references: [id])
  attempts           Attempt[]
  profile            StudentProfile?
  attendances        Attendance[]
  memberships        GroupMembership[]
  assignmentGrades   AssignmentGrade[]
  adjustments        PointAdjustment[]
  oralScores         OralScore[]
  penalties          Penalty[]
  createdTests       Test[]            @relation("TestAuthor")
  // Menejerning regioni (faqat MANAGER uchun); doirasi: region guruhlari + ManagerGroup
  regionId           String?
  region             Region?           @relation(fields: [regionId], references: [id], onDelete: SetNull)
  managedGroups      ManagerGroup[]    @relation("ManagerGroupManager")
  // O'qituvchi: regionlari, guruhlari, menejerlari, jarima shablonlari, testlari
  teacherRegions     TeacherRegion[]
  taughtGroups       Group[]           @relation("GroupTeacher")
  managers           TeacherManager[]  @relation("TeacherManagerTeacher")
  // Menejer: qaysi o'qituvchilar bilan ishlaydi
  teachers           TeacherManager[]  @relation("TeacherManagerManager")
  assignedGroups     ManagerGroup[]    @relation("ManagerGroupAssigner")
  penaltyTypes       PenaltyType[]
  ownedTests         Test[]            @relation("TestOwner")
  testShares         TestShare[]
  // O'quvchini kim qo'shgan (menejer guruhsiz o'quvchini faqat o'zi qo'shgan bo'lsa ko'radi)
  createdById        String?
  createdBy          User?             @relation("CreatedStudents", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers       User[]            @relation("CreatedStudents")
  deletionRequests   DeletionRequest[] @relation("DeletionStudent")
  requestedDeletions DeletionRequest[] @relation("DeletionRequester")
  decidedDeletions   DeletionRequest[] @relation("DeletionDecider")
  createdAt          DateTime          @default(now())
}

// Guruh o'qituvchiga tegishli. Nom takrorlanishi mumkin; guruhni kod farqlaydi
// (lib/group-code.ts, masalan SHOA-1-SH). seq butun loyiha bo'yicha, qayta berilmaydi;
// code bir marta yoziladi va o'zgarmaydi (regionsiz guruhda region harfisiz)
model Group {
  id          String            @id @default(cuid())
  name        String
  seq         Int               @unique @default(autoincrement())
  code        String?           @unique
  teacherId   String
  teacher     User              @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  students    User[]
  tests       Test[]
  schedules   GroupSchedule[]
  lessons     Lesson[]
  memberships GroupMembership[]
  semesters   Semester[]
  regionId    String?
  region      Region?           @relation(fields: [regionId], references: [id], onDelete: SetNull)
  managers    ManagerGroup[]
  createdAt   DateTime          @default(now())

  @@index([teacherId])
}

model Test {
  id               String      @id @default(cuid())
  title            String
  description      String?
  durationMin      Int
  isActive         Boolean     @default(false)
  allowRetake      Boolean     @default(true)
  showAnswers      Boolean     @default(false)
  shuffleQuestions Boolean     @default(false)
  shuffleOptions   Boolean     @default(false)
  // Ochiq bo'lish oralig'i (ixtiyoriy). Ochiq = isActive va startsAt <= hozir < endsAt (lib/tests/schedule.ts)
  startsAt         DateTime?
  endsAt           DateTime?
  createdById      String
  createdBy        User        @relation("TestAuthor", fields: [createdById], references: [id])
  // Egasi — o'qituvchi (menejer yaratgan testda null: u ishlaydigan o'qituvchilar nusxa oladi)
  ownerId          String?
  owner            User?       @relation("TestOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // Ulashilgan testdan olingan nusxa: qaysi testdan
  copiedFromId     String?
  copiedFrom       Test?       @relation("TestCopy", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies           Test[]      @relation("TestCopy")
  shares           TestShare[]
  groups           Group[]
  questions        Question[]
  attempts         Attempt[]
  createdAt        DateTime    @default(now())
}

model Question {
  id      String       @id @default(cuid())
  testId  String
  test    Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  text    String
  type    QuestionType @default(SINGLE)
  points  Int          @default(1)
  order   Int
  options Option[]
  answers Answer[]
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int
}

model Attempt {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  testId         String
  test           Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  status         AttemptStatus @default(IN_PROGRESS)
  isFirst        Boolean
  startedAt      DateTime      @default(now())
  deadlineAt     DateTime
  finishedAt     DateTime?
  durationSec    Int?
  score          Int?
  maxScore       Int?
  // Savollar tartibi (question id'lar) — boshlanganda bir marta belgilanadi, yangilansa o'zgarmaydi
  questionOrder  String[]      @default([])
  // Variantlar aralashtirilganmi (boshlangandagi sozlama). Tartib saqlanmaydi:
  // attemptId + questionId urug'idan hisoblanadi (lib/grading.ts optionOrderFor)
  shuffleOptions Boolean       @default(false)
  answers        Answer[]

  @@index([testId, isFirst, status])
  @@index([userId, testId])
}

model Answer {
  id                String   @id @default(cuid())
  attemptId         String
  attempt           Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionIds String[]
  isCorrect         Boolean?
  updatedAt         DateTime @updatedAt

  @@unique([attemptId, questionId])
}

// Login cheklovi: username bo'yicha xato urinishlar (15 daqiqalik oyna)
model LoginFailure {
  id        String   @id @default(cuid())
  username  String
  createdAt DateTime @default(now())

  @@index([username, createdAt])
}

// O'quvchining shaxsiy va aloqa ma'lumotlari (faqat o'qituvchi ko'radi — CLAUDE.md, 10-qoida)
model StudentProfile {
  id             String          @id @default(cuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone          String? // +998901234567
  telegram       String? // @username yoki +998...
  parentName     String?
  parentRelation ParentRelation?
  parentPhone    String?
  note           String?
  updatedAt      DateTime        @updatedAt
}

// Guruhning haftalik dars jadvali: har bir dars kuni uchun bitta qator
model GroupSchedule {
  id        String @id @default(cuid())
  groupId   String
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  weekday   Int // 1 = Dushanba ... 7 = Yakshanba
  startTime String // "14:00"
  endTime   String // "16:00"

  @@unique([groupId, weekday])
}

// Bitta o'tilgan dars (ma'lum sana, Asia/Tashkent)
model Lesson {
  id          String       @id @default(cuid())
  groupId     String
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date        DateTime     @db.Date
  topic       String?
  attendances Attendance[]
  oralScores  OralScore[]
  // Shu darsda berilgan topshiriqlar (uyga vazifa darsga bog'lanadi)
  assignments Assignment[]
  createdAt   DateTime     @default(now())

  @@unique([groupId, date])
}

model Attendance {
  id        String           @id @default(cuid())
  lessonId  String
  lesson    Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus
  note      String?
  updatedAt DateTime         @updatedAt

  @@unique([lessonId, studentId])
}

// O'quvchining guruhlar tarixi. leftAt = null — hozirgi guruh (User.groupId bilan doim mos,
// bitta tranzaksiyada yangilanadi — lib/memberships.ts). Sanalar Toshkent bo'yicha kunga solishtiriladi:
// a'zolik [joinedAt kuni, leftAt kuni) oralig'idagi darslarni qamraydi
model GroupMembership {
  id        String    @id @default(cuid())
  studentId String
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  joinedAt  DateTime
  leftAt    DateTime?
  note      String?
  createdAt DateTime  @default(now())

  @@index([studentId, joinedAt])
  @@index([groupId, joinedAt])
}

// Semestr bali (PLAN.md, 17-bosqich): har guruhga alohida semestrlar.
// Jadval nomi eskicha ("Period") — ma'lumot ko'chirilmaydi
model Semester {
  id           String            @id @default(cuid())
  groupId      String
  group        Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name         String
  startDate    DateTime          @db.Date
  endDate      DateTime          @db.Date
  // O'qituvchi semestrni muddatidan oldin yopishi mumkin (EXTRA shundan keyin qo'yiladi)
  closed       Boolean           @default(false)
  maxTotal     Int               @default(60)
  // O'tish: jami >= maxTotal * passPercent / 100 (60 dan 36)
  passPercent  Int               @default(60)
  // EXTRA'siz jami shundan kam bo'lsa — yiqildi, qo'shimcha imkoniyat yo'q
  failBelow    Int               @default(10)
  homeworkCap  Int               @default(30)
  practicalCap Int               @default(20)
  oralCap      Int               @default(10)
  // Ishlatilmaydi: qo'shimcha ball chegarasiz (2026-11-06)
  extraCap     Int               @default(40)
  assignments  Assignment[]
  adjustments  PointAdjustment[]
  penalties    Penalty[]
  createdAt    DateTime          @default(now())

  @@unique([groupId, name])
  @@index([groupId, startDate])
  @@map("Period")
}

enum AssignmentCategory {
  HOMEWORK
  PRACTICAL
  EXTRA
  BONUS
}

// Topshiriq (uyga vazifa, amaliy, qo'shimcha, bonus). O'quvchi saytda hech narsa topshirmaydi:
// ishni darsda ko'rsatadi, ballni o'qituvchi qo'yadi. HOMEWORK doim maxPoints = 1.
// Jadval nomi eskicha ("Homework")
model Assignment {
  id          String             @id @default(cuid())
  semesterId  String             @map("periodId")
  semester    Semester           @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  category    AssignmentCategory @default(HOMEWORK)
  // Qaysi darsda berilgan (uyga vazifa); eski topshiriqlarda null
  lessonId    String?
  lesson      Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title       String
  description String?
  dueDate     DateTime           @db.Date
  maxPoints   Int
  // Uyga vazifaga 0 qo'yilsa avtomatik jarima. 2026-10-15 gacha berilganlarda 1, yangilarida 2
  missPenalty Int                @default(2)
  createdById String
  grades      AssignmentGrade[]
  createdAt   DateTime           @default(now())

  @@index([semesterId, dueDate])
  @@index([lessonId])
  @@map("Homework")
}

// Topshiriq bali: HOMEWORK — 0 / 0.5 / 1, qolganlari 0..maxPoints (0.5 qadam)
model AssignmentGrade {
  id           String     @id @default(cuid())
  assignmentId String     @map("homeworkId")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  points       Float
  note         String?
  gradedAt     DateTime   @updatedAt

  @@unique([assignmentId, studentId])
  @@map("HomeworkGrade")
}

// Og'zaki savol-javob: dars kuni 0 / 0.5 / 1. Semestri dars sanasidan aniqlanadi
model OralScore {
  id          String   @id @default(cuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  points      Float
  note        String?
  createdById String
  updatedAt   DateTime @updatedAt

  @@unique([lessonId, studentId])
  @@index([studentId])
}

// Semestr baliga qo'lda tuzatish (manfiy ham bo'lishi mumkin), masalan boshqa guruhdan
// o'tkazilgan o'quvchining ballari
model PointAdjustment {
  id             String   @id @default(cuid())
  studentId      String
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semesterId     String   @map("periodId")
  semester       Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  points         Float
  reason         String
  // Guruhga o'tkazishda ko'chirilgan ball: qaysi semestrdan kelgan (qaytib o'tkazilganda
  // ikki marta hisoblanmasin — lib/grades-data.ts planPointCarryOver)
  fromSemesterId String?
  createdById    String
  createdAt      DateTime @default(now())

  @@index([studentId, semesterId])
}

// Jarima shablonlari (Sozlamalar → Jarima shablonlari). Nofaol shablon tanlashda chiqmaydi,
// lekin eski jarimalarda nomi saqlanadi (o'chirish — faqat ishlatilmagan bo'lsa)
model PenaltyType {
  id            String    @id @default(cuid())
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  defaultPoints Float
  description   String?
  isActive      Boolean   @default(true)
  penalties     Penalty[]
  createdAt     DateTime  @default(now())

  @@unique([ownerId, name])
}

// Jarima: semestr jamidan 60 lik chegaradan KEYIN ayiriladi (lib/grades.ts).
// points shablondan nusxa olinadi (o'zgartirsa bo'ladi)
model Penalty {
  id          String      @id @default(cuid())
  studentId   String
  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semesterId  String
  semester    Semester    @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  typeId      String
  type        PenaltyType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  points      Float
  note        String?
  date        DateTime    @db.Date
  createdById String
  createdAt   DateTime    @default(now())

  @@index([semesterId, studentId])
  @@index([studentId])
}

model Region {
  id         String          @id @default(cuid())
  name       String          @unique
  groups     Group[]
  managers   User[]
  teachers   TeacherRegion[]
  testShares TestShare[]
  createdAt  DateTime        @default(now())
}

// Menejer doirasi: o'qituvchilar unga biriktirgan guruhlar (boshqa regiondan ham bo'lishi
// mumkin). O'qituvchi faqat o'z guruhlarini biriktiradi
model ManagerGroup {
  id           String   @id @default(cuid())
  managerId    String
  manager      User     @relation("ManagerGroupManager", fields: [managerId], references: [id], onDelete: Cascade)
  groupId      String
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User     @relation("ManagerGroupAssigner", fields: [assignedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([managerId, groupId])
}

// O'qituvchining regionlari (faqat ADMIN biriktiradi). Guruh va o'qituvchi yaratgan menejer
// regioni shulardan biri bo'ladi
model TeacherRegion {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  regionId  String
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teacherId, regionId])
  @@index([regionId])
}

// Qaysi o'qituvchi qaysi menejer bilan ishlaydi
model TeacherManager {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation("TeacherManagerTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  managerId String
  manager   User     @relation("TeacherManagerManager", fields: [managerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teacherId, managerId])
  @@index([managerId])
}

// Test ulashish: regionga (shu regiondagi o'qituvchilar) yoki bitta o'qituvchiga.
// Oluvchi o'z nusxasini oladi (Test.copiedFromId), asl test o'zgarmaydi.
// Aynan bittasi to'ldiriladi (CHECK — faqat SQL migratsiyada)
model TestShare {
  id        String   @id @default(cuid())
  testId    String
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  regionId  String?
  region    Region?  @relation(fields: [regionId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   User?    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([testId, regionId])
  @@unique([testId, teacherId])
  @@index([teacherId])
  @@index([regionId])
}

// Menejerning o'quvchini o'chirish so'rovi. Tasdiqlansa o'quvchi arxivlanadi.
// Bitta o'quvchiga bir vaqtda faqat bitta PENDING: qisman unique indeks (faqat SQL migratsiyada)
model DeletionRequest {
  id            String         @id @default(cuid())
  studentId     String
  student       User           @relation("DeletionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User           @relation("DeletionRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reason        String
  status        DeletionStatus @default(PENDING)
  decidedById   String?
  decidedBy     User?          @relation("DeletionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime       @default(now())

  @@index([status, createdAt])
  @@index([requestedById, createdAt])
}
